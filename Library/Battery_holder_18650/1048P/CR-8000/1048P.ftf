(ftf
  (header
    (version 2.0)
    (unit DBUNIT)
  )
  (TechnologyContainer
    (technology SamacSys_Footprint
      (footprintLayer
        (layer Top (type Conductive))
        (layer Inner (type Conductive))
        (layer Bottom (type Conductive))
        (layer Silk-Top (type Symbolmark))
        (layer Silk-Bottom (type Symbolmark))
        (layer Resist-Top (type Solderresist))
        (layer Resist-Bottom (type Solderresist))
        (layer MetalMask-Top (type Metalmask))
        (layer MetalMask-Bottom (type Metalmask))
        (layer CompArea-Top (type Comparea))
        (layer CompArea-Bottom (type Comparea))
        (layer Assembly-Top (type Undefined))
        (layer Assembly-Bottom (type Undefined))
        (layer Hole (type Hole))
      )
    )
  )
  (footprintContainer
    (commonParameters
      (dimensionParameters
        (arrowLength 100000)
        (arrowAngle 15.000000)
        (dotDiameter 100000)
        (textFrameOffset 100000)
        (arrowOffset 100000)
        (dimAssistOffset 100000)
        (dimLineWidth 10000)
        (drawTextFrame NO)
        (textFrameRange ALL)
        (textClip NO)
        (standard JIS)
      )
    )
    (padstackGroups
      (padstackGroup default)
    )
    (pads
      (pad r734_635
        (photo FLASH)
        (panelUse NO)
        (geometry
          (rectangle
            (pt 0 0)
            (width 635000)
            (height 734000)
            (rAngle 0.000000)
            (outlineWidth 0)
            (fillWidth 0)
            (fillAngle 0.000000)
          )
        )
      )
      (pad c239
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 119500
            (pt 0 0)
          )
        )
      )
      (pad c470
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 235000
            (pt 0 0)
          )
        )
      )
      (pad c345
        (photo FLASH)
        (panelUse NO)
        (geometry
          (circle 172500
            (pt 0 0)
          )
        )
      )
    ); End of pads
    (padstacks
      (padstack r734_635
        (type NONPLATED)
        (throughMode NONTHROUGH)
        (panelUse NO)
        (padSet (footLayer Top)
          (connect (pad r734_635))
          (noconnect (pad r734_635))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad r734_635))
          (noconnect (pad r734_635))
        )
        (padSet (footLayer MetalMask-Top)
          (connect (pad r734_635))
          (noconnect (pad r734_635))
        )
      )
      (padstack c239h239
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 119500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c239))
          (noconnect (pad c239))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c239))
          (noconnect (pad c239))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c239))
          (noconnect (pad c239))
        )
        (padSet (footLayer Inner)
          (clearance (pad c239))
          (connect (pad c239))
          (noconnect (pad c239))
        )
        (padSet (footLayer Bottom)
          (connect (pad c239))
          (noconnect (pad c239))
        )
      )
      (padstack c470h317
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 158500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c470))
          (noconnect (pad c470))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c470))
          (noconnect (pad c470))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c470))
          (noconnect (pad c470))
        )
        (padSet (footLayer Inner)
          (clearance (pad c470))
          (connect (pad c470))
          (noconnect (pad c470))
        )
        (padSet (footLayer Bottom)
          (connect (pad c470))
          (noconnect (pad c470))
        )
      )
      (padstack c470h317
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 158500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c470))
          (noconnect (pad c470))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c470))
          (noconnect (pad c470))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c470))
          (noconnect (pad c470))
        )
        (padSet (footLayer Inner)
          (clearance (pad c470))
          (connect (pad c470))
          (noconnect (pad c470))
        )
        (padSet (footLayer Bottom)
          (connect (pad c470))
          (noconnect (pad c470))
        )
      )
      (padstack c345h345
        (type PLATED)
        (throughMode THROUGH)
        (panelUse NO)
        (Hole (footLayer Hole)
          (geometry
            (circle 172500
              (pt 0 0)
            )
          )
        )
        (padSet (footLayer Top)
          (connect (pad c345))
          (noconnect (pad c345))
        )
        (padSet (footLayer Resist-Top)
          (connect (pad c345))
          (noconnect (pad c345))
        )
        (padSet (footLayer Resist-Bottom)
          (connect (pad c345))
          (noconnect (pad c345))
        )
        (padSet (footLayer Inner)
          (clearance (pad c345))
          (connect (pad c345))
          (noconnect (pad c345))
        )
        (padSet (footLayer Bottom)
          (connect (pad c345))
          (noconnect (pad c345))
        )
      )
    ); End of padstacks
    (footprints
      (footprint "1048P"
        (polarity YES)
        (panelUse NO)
        (heelprint
          (layout
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -3853000 1989000
                        (width 20000)
                      )
                      (pt 3853000 1989000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 3853000 1989000
                        (width 20000)
                      )
                      (pt 3853000 -1989000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 3853000 -1989000
                        (width 20000)
                      )
                      (pt -3853000 -1989000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Assembly-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -3853000 -1989000
                        (width 20000)
                      )
                      (pt -3853000 1989000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt -3853000 1989000
                        (width 20000)
                      )
                      (pt 3853000 1989000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (pt 3853000 -1989000
                        (width 20000)
                      )
                      (pt -3853000 -1989000
                        (width 20000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
                      (arc CW
                        (r 25200)
                        (begin
                          (pt -4387100 1012100
                            (width 40000)
                          )
                        )
                        (center 0 0)
                        (end
                          (pt -4387100 1012100
                            (width 40000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
           ); End of layout
         ); End of heelprint
         (toeprint
          (pin 1
            (pt -3889000 955500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -3889000 955500)
                  (angle 90)
                  (padstackGroup default (padstack r734_635))
                )
              )
            )
          )
          (pin 2
            (pt -3889000 -955500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -3889000 -955500)
                  (angle 90)
                  (padstackGroup default (padstack r734_635))
                )
              )
            )
          )
          (pin 3
            (pt 3889000 -955500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 3889000 -955500)
                  (angle 90)
                  (padstackGroup default (padstack r734_635))
                )
              )
            )
          )
          (pin 4
            (pt 3889000 955500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 3889000 955500)
                  (angle 90)
                  (padstackGroup default (padstack r734_635))
                )
              )
            )
          )
          (pin 5
            (pt 2760000 1750500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 2760000 1750500)
                  (angle 90)
                  (padstackGroup default (padstack c345h345))
                )
              )
            )
          )
          (pin 6
            (pt 2760000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 2760000 0)
                  (angle 90)
                  (padstackGroup default (padstack c470h317))
                )
              )
            )
          )
          (pin 7
            (pt -2760000 0)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -2760000 0)
                  (angle 90)
                  (padstackGroup default (padstack c470h317))
                )
              )
            )
          )
          (pin 8
            (pt -2760000 -1750500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt -2760000 -1750500)
                  (angle 90)
                  (padstackGroup default (padstack c345h345))
                )
              )
            )
          )
          (pin 9
            (pt 3582000 -1750500)
            (layout
              (layer (FPADSTACK)
                (fpadstack
                  (pt 3582000 -1750500)
                  (angle 90)
                  (padstackGroup default (padstack c239h239))
                )
              )
            )
          )
        ); End of toeprint
        (propertyS accurateShape 1048P.stp)
      ); End of footprint
    ); End of footprints
  );  End of footprintContainer
); End of ftf

